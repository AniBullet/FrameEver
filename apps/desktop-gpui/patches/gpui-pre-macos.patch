+    /// Paint a surface into `bounds`, positioning and scaling it according to `image_bounds`,
+    /// as [`Self::paint_image`] does for images.
+    ///
+    /// The visible region rendered is `bounds.intersect(&image_bounds)`, with `corner_radii`
+    /// applied to it. Bi-planar 4:2:0 full-range and 32-bit BGRA buffers are supported.
+    ///
+    /// This method should only be called as part of the paint phase of element drawing.
+    #[cfg(any(target_os = "macos", target_os = "ios"))]
+    pub fn paint_surface_fitted(
