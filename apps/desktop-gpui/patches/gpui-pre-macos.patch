+            let row_bytes = CVPixelBufferGetBytesPerRow(&image_buffer);
+            let rows = slice::from_raw_parts_mut(bytes, row_bytes * 16);
+            for row in rows.chunks_mut(row_bytes) {
+                for (column, pixel) in row[..32 * 4].chunks_mut(4).enumerate() {
+                    let bgra = if column < 16 {
+                        [0, 0, 255, 255]
+                    } else {
+                        [255, 0, 0, 255]
+                    };
+                    pixel.copy_from_slice(&bgra);
+                }
+            }
