+
+/// The part of a surface's texture, in normalized coordinates, that shows inside
+/// `visible_bounds` when the whole texture is laid out over `image_bounds`.
+#[cfg(any(test, target_os = "macos", target_os = "ios"))]
+fn surface_source_uv(visible_bounds: Bounds<Pixels>, image_bounds: Bounds<Pixels>) -> Bounds<f32> {
+    if visible_bounds == image_bounds {
+        return Bounds {
+            origin: point(0., 0.),
+            size: size(1., 1.),
+        };
+    }
+    Bounds {
+        origin: point(
+            (visible_bounds.origin.x - image_bounds.origin.x) / image_bounds.size.width,
+            (visible_bounds.origin.y - image_bounds.origin.y) / image_bounds.size.height,
+        ),
+        size: size(
+            visible_bounds.size.width / image_bounds.size.width,
+            visible_bounds.size.height / image_bounds.size.height,
+        ),
+    }
+}
+
+#[cfg(test)]
+mod surface_source_uv_tests {
+    use super::*;
+
+    #[test]
+    fn a_surface_that_fills_its_bounds_samples_the_whole_texture() {
+        let bounds = Bounds::new(point(px(10.), px(20.)), size(px(200.), px(100.)));
+        assert_eq!(
+            surface_source_uv(bounds, bounds),
+            Bounds::new(point(0., 0.), size(1., 1.))
+        );
+    }
+
+    #[test]
+    fn a_covered_surface_samples_only_the_visible_middle() {
+        let visible = Bounds::new(point(px(0.), px(0.)), size(px(100.), px(100.)));
+        let image = Bounds::new(point(px(-50.), px(0.)), size(px(200.), px(100.)));
+        assert_eq!(
+            surface_source_uv(visible, image),
+            Bounds::new(point(0.25, 0.), size(0.5, 1.))
+        );
+    }
+}
