{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "FrameEver",
	"mainBinaryName": "FrameEver",
	"identifier": "io.github.anibullet.frameever",
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["frameever"]
			}
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": "all",
		"category": "Video",
		"publisher": "aniBullet",
		"copyright": "FrameEver by aniBullet, based on Cap (AGPL-3.0)",
		"shortDescription": "Local-first screen recorder and editor",
		"longDescription": "FrameEver is a local-first screen recorder and editor. Recordings, edits and captions stay on your computer.",
		"externalBin": [
			"binaries/frameever-muxer",
			"binaries/frameever-cli"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"assets/backgrounds/macOS/*": "assets/backgrounds/macOS/",
			"assets/backgrounds/blue/*": "assets/backgrounds/blue/",
			"assets/backgrounds/cities/*": "assets/backgrounds/cities/",
			"assets/backgrounds/dark/*": "assets/backgrounds/dark/",
			"assets/backgrounds/orange/*": "assets/backgrounds/orange/",
			"assets/backgrounds/purple/*": "assets/backgrounds/purple/",
			"assets/music/*.mp3": "assets/music/",
			"assets/icons/LICENSE-*.txt": "licenses/icons/",
			"assets/fonts/harmonyos-sans/LICENSE-*.txt": "licenses/fonts/"
		},
		"fileAssociations": [
			{
				"ext": ["cap"],
				"name": "FrameEver Project",
				"mimeType": "application/x-cap-project",
				"role": "Editor"
			}
		],
		"macOS": {
			"minimumSystemVersion": "12.3",
			"entitlements": "packaging/macos/Entitlements.plist",
			"frameworks": ["../../target/native-deps/Spacedrive.framework"],
			"dmg": {
				"background": "packaging/macos/dmg-background.png",
				"appPosition": {
					"x": 180,
					"y": 140
				},
				"applicationFolderPosition": {
					"x": 480,
					"y": 140
				}
			}
		},
		"windows": {
			"nsis": {
				"headerImage": "packaging/windows/nsis-header.bmp",
				"sidebarImage": "packaging/windows/nsis-sidebar.bmp",
				"installerIcon": "icons/icon.ico",
				"installMode": "currentUser",
				"languages": ["English", "SimpChinese"],
				"installerHooks": "packaging/windows/installer-hooks.nsh",
				"compression": "lzma"
			},
			"webviewInstallMode": {
				"type": "skip"
			}
		}
	}
}
