{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "FrameEver",
	"mainBinaryName": "FrameEver",
	"identifier": "io.github.anibullet.frameever",
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["frameever"]
			}
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": "all",
		"category": "Video",
		"publisher": "aniBullet",
		"copyright": "FrameEver by aniBullet, based on Cap (AGPL-3.0)",
		"shortDescription": "Local-first screen recorder and editor",
		"longDescription": "FrameEver is a local-first screen recorder and editor. Recordings, edits and captions stay on your computer.",
		"externalBin": [
			"../desktop/src-tauri/binaries/frameever-muxer",
			"../desktop/src-tauri/binaries/frameever-cli"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"../desktop/src-tauri/assets/backgrounds/macOS/*": "assets/backgrounds/macOS/",
			"../desktop/src-tauri/assets/backgrounds/blue/*": "assets/backgrounds/blue/",
			"../desktop/src-tauri/assets/backgrounds/cities/*": "assets/backgrounds/cities/",
			"../desktop/src-tauri/assets/backgrounds/dark/*": "assets/backgrounds/dark/",
			"../desktop/src-tauri/assets/backgrounds/orange/*": "assets/backgrounds/orange/",
			"../desktop/src-tauri/assets/backgrounds/purple/*": "assets/backgrounds/purple/",
			"../desktop/src/assets/music/*.mp3": "assets/music/"
		},
		"fileAssociations": [
			{
				"ext": ["cap"],
				"name": "FrameEver Project",
				"mimeType": "application/x-cap-project",
				"role": "Editor"
			}
		],
		"macOS": {
			"minimumSystemVersion": "12.3",
			"entitlements": "../desktop/src-tauri/Entitlements.plist",
			"frameworks": ["../../target/native-deps/Spacedrive.framework"],
			"dmg": {
				"background": "../desktop/src-tauri/assets/dmg-background.png",
				"appPosition": {
					"x": 180,
					"y": 140
				},
				"applicationFolderPosition": {
					"x": 480,
					"y": 140
				}
			}
		},
		"windows": {
			"nsis": {
				"headerImage": "packaging/windows/nsis-header.bmp",
				"sidebarImage": "packaging/windows/nsis-sidebar.bmp",
				"installerIcon": "icons/icon.ico",
				"installMode": "currentUser",
				"languages": ["English", "SimpChinese"],
				"installerHooks": "packaging/windows/installer-hooks.nsh",
				"compression": "lzma"
			},
			"webviewInstallMode": {
				"type": "skip"
			}
		},
		"linux": {
			"deb": {
				"depends": [
					"libc6 (>= 2.39)",
					"libva2",
					"libva-drm2",
					"pulseaudio-utils",
					"libpipewire-0.3-0",
					"libasound2t64 | libasound2",
					"libxkbcommon0",
					"libxkbcommon-x11-0",
					"libx11-6",
					"libssl3t64 | libssl3",
					"libwayland-client0",
					"libwayland-egl1",
					"libegl1",
					"libvulkan1"
				]
			}
		}
	}
}
